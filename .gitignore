# OS
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# Python (practical default for this project)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Node (in case any future stack module needs it)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key

# Build artifacts
dist/
/build/
*.egg

# Logs
*.log
logs/

# Claude Code local-only state (personal allowlists, machine-specific settings)
**/settings.local.json
.claude/.local*

# Local Claude Code hook output (per ADR-0015 D4)
.claude/logs/

# Runtime cache (non-logs, non-tracked — e.g. PRD-correlation disk cache)
.claude/cache/

# Human-ack sentinel for promote.sh gate (slice #881, fixes #880).
# Gitignored so it never exists in subagent worktrees (which check out
# tracked files only), structurally blocking any subagent from promoting.
.claude/PROMOTE_OK

# Disposable SQLite trace read-model (refoldable from trace-v3.jsonl;
# never a second source of truth — slice #1080, ADR-0075 D2).
.claude/state/

# Per-dispatch isolated worktree checkouts (ADR-0036) — .git/info/exclude
# alone doesn't survive a fresh clone, so subagent worktrees show up as
# untracked dirs on every other clone without this.
.claude/worktrees/
